diff --git a/android/app/src/main/java/com/rklab/healthvault/ui/screens/documents/ShareLinkDialog.kt b/android/app/src/main/java/com/rklab/healthvault/ui/screens/documents/ShareLinkDialog.kt
new file mode 100644
