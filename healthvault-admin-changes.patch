new file mode 100644
index 0000000..746d7d7
--- /dev/null
+++ b/backend/app/templates/activity.html
@@ -0,0 +1,46 @@
+{% extends "base.html" %}
+{% block title %}Activity{% endblock %}
+{% block content %}
+<div class="page-title">Activity</div>
+
+<h3 style="font-size:14px; color:var(--ink-soft); margin:18px 0 8px;">Share links</h3>
+<table class="ledger surface">
+  <thead><tr><th>Document</th><th>Expires</th><th>Views</th><th>Status</th><th></th></tr></thead>
+  <tbody>
+    {% for link in share_links %}
+    <tr>
+      <td>{{ doc_titles.get(link.document_id, '—') }}</td>
+      <td class="mono">{{ link.expires_at.strftime('%Y-%m-%d %H:%M') }}</td>
+      <td class="mono">{{ link.view_count }}{% if link.max_views %} / {{ link.max_views }}{% endif %}</td>
+      <td>{% if link.revoked %}<span class="tag" style="background:#F1DEDA; color:#B23B36;">Revoked</span>{% else %}<span class="tag tag-sage">Active</span>{% endif %}</td>
+      <td>
+        {% if not link.revoked %}
+        <form method="post" action="/admin/activity/share/{{ link.id }}/revoke" onsubmit="return confirm('Revoke this link?');">
+          <button class="tag" style="background:#F1DEDA; color:#B23B36; border:none; cursor:pointer;" type="submit">Revoke</button>
+        </form>
+        {% endif %}
+      </td>
+    </tr>
+    {% else %}
+    <tr><td colspan="5" class="empty">No share links yet.</td></tr>
+    {% endfor %}
+  </tbody>
+</table>
+
+<h3 style="font-size:14px; color:var(--ink-soft); margin:24px 0 8px;">Recent activity</h3>
+<table class="ledger surface">
+  <thead><tr><th>When</th><th>Action</th><th>Document</th><th>Detail</th></tr></thead>
+  <tbody>
+    {% for entry in entries %}
+    <tr>
+      <td class="mono">{{ entry.created_at.strftime('%Y-%m-%d %H:%M') }}</td>
+      <td>{{ entry.action.value.replace('_', ' ') | title }}</td>
+      <td>{{ doc_titles.get(entry.document_id, '—') }}</td>
+      <td style="color:var(--ink-soft); font-size:12.5px;">{{ entry.detail or '—' }}</td>
+    </tr>
+    {% else %}
+    <tr><td colspan="4" class="empty">No activity yet.</td></tr>
+    {% endfor %}
+  </tbody>
+</table>
+{% endblock %}
