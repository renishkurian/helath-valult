# Copy this to .env and fill in real values. Never commit the real .env.

# --- Database ---
# SQLite (default, fine for a single-user Pi setup):
DATABASE_URL=sqlite:///./healthvault.db
# Or MySQL, to match your existing MarketMind DB:
# DATABASE_URL=mysql+pymysql://healthvault:CHANGE_ME@127.0.0.1:3306/healthvault

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Login hardening. Lockout is per email *and* per IP over the window.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
ONLINE_WINDOW_MINUTES=5

# Google reCAPTCHA v2 ("I'm not a robot"). Leave both empty to disable.
# Create keys at https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=

# First superadmin. Created or promoted on startup if email is set.
# SUPERADMIN_EMAIL=you@example.com
# SUPERADMIN_PASSWORD=change-me-now
# SUPERADMIN_NAME=You

# --- Encryption (medical data at rest) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# BACK THIS KEY UP SOMEWHERE SAFE (e.g. Vaultwarden). If you lose it, all
# encrypted cards/notes/files become permanently unreadable.
MASTER_KEY=CHANGE_ME

# --- Storage ---
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25

# --- CORS ---
# Tighten this once you know the app isn't calling from a browser context.
CORS_ORIGINS=*

# Optional fallbacks if Super Admin → Server settings is empty.
# Prefer saving these there (encrypted in the DB).
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxx
# FCM_SERVER_KEY=AAAA...   # Firebase Cloud Messaging server key only
