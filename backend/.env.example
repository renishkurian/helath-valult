# Copy this to .env and fill in real values. Never commit the real .env.

# --- Database ---
# SQLite (default, fine for a single-user Pi setup):
DATABASE_URL=sqlite:///./healthvault.db
# Or MySQL, to match your existing MarketMind DB:
# DATABASE_URL=mysql+pymysql://healthvault:CHANGE_ME@127.0.0.1:3306/healthvault

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Encryption (medical data at rest) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# BACK THIS KEY UP SOMEWHERE SAFE (e.g. Vaultwarden). If you lose it, all
# encrypted cards/notes/files become permanently unreadable.
MASTER_KEY=CHANGE_ME

# --- Storage ---
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25

# --- CORS ---
# Tighten this once you know the app isn't calling from a browser context.
CORS_ORIGINS=*
