{
  "id": "/",
  "name": "Family Vault",
  "short_name": "Vault",
  "description": "Self-hosted family vault: household members, health, passwords, money, documents, and links.",
  "start_url": "/admin/modules",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#0A0C11",
  "theme_color": "#0A0C11",
  "categories": ["productivity", "utilities"],
  "icons": [
    {
      "src": "/static/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/static/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    { "name": "Modules", "url": "/admin/modules", "icons": [{ "src": "/static/icon-192.png", "sizes": "192x192" }] },
    { "name": "Passwords", "url": "/admin/passwords", "icons": [{ "src": "/static/icon-192.png", "sizes": "192x192" }] },
    { "name": "Health", "url": "/admin", "icons": [{ "src": "/static/icon-192.png", "sizes": "192x192" }] },
    { "name": "Emergency card", "url": "/admin/care", "icons": [{ "src": "/static/icon-192.png", "sizes": "192x192" }] }
  ]
}
